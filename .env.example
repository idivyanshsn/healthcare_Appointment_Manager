# Next.js App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LLM Providers (Optional - The app automatically uses an advanced clinical fallback engine if keys are omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Google Calendar API (OAuth 2.0 Integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Email Notification Service
RESEND_API_KEY=
EMAIL_FROM=notifications@healthmanager.clinic
CRON_SECRET=healthcare_cron_secret_secure_key_123
